# Stage 1: instalar dependencias en venv aislado
FROM python:3.12-alpine AS deps
WORKDIR /app
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.producer.txt .
RUN pip install --no-cache-dir -r requirements.producer.txt

# Stage 2: imagen final minima
FROM python:3.12-alpine
ENV PATH="/opt/venv/bin:$PATH"
COPY --from=deps /opt/venv /opt/venv

# Scripts vienen del bind mount - no se copian aqui
WORKDIR /opt/spark-scripts

RUN adduser -D -H appuser
USER appuser

CMD ["python", "producer.py"]
